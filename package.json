{
  "name": "n8n-nodes-pixconvert",
  "version": "1.0.0",
  "description": "n8n community node for PixConvert PDF and image processing API",
  "keywords": ["n8n-community-node-package"],
  "license": "MIT",
  "homepage": "https://github.com/rushikeshsakharleofficial/n8n-nodes-pixconvert",
  "repository": {
    "type": "git",
    "url": "https://github.com/rushikeshsakharleofficial/n8n-nodes-pixconvert.git"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && gulp build:icons",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint nodes credentials --ext .ts",
    "test": "jest",
    "prepublishOnly": "npm run build && npm test"
  },
  "files": ["dist"],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": ["dist/credentials/PixConvertApi.credentials.js"],
    "nodes": ["dist/nodes/PixConvert/PixConvert.node.js"]
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "gulp": "^4.0.2",
    "jest": "^29.5.0",
    "n8n-workflow": "^1.0.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.1.0"
  },
  "peerDependencies": {
    "n8n-workflow": "^1.0.0"
  },
  "dependencies": {
    "form-data": "^4.0.0"
  }
}
